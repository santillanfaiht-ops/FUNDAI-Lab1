        "\n",
        "# Assuming TicTacToe class is defined in a previous cell\n",
        "# and minimax_alpha_beta is a standalone function or accessible.\n",
        "\n",
        "class TicTacToeUI:\n",
        "  def __init__(self):\n",
        "    self.game = TicTacToe()\n",
        "\n",
        "    self.buttons = [\n",
        "        widgets.Button(\n",
        "            description=\" \",\n",
